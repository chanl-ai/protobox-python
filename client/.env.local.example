NEXT_PUBLIC_API_URL=http://localhost:8090
NEXT_PUBLIC_MCP_BASE_URL=http://localhost:8090
MCP_SERVER_URL=http://localhost:8090

# Firebase Auth emulator (started by `make up`). Any API key value works with the emulator.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9299
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-protobox
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-protobox.firebaseapp.com
