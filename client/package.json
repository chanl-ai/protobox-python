{
  "name": "protobox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "dev:local": "next dev --port 3010",
    "prebuild": "node scripts/generate-build-info.js",
    "build": "next build",
    "build:local": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "kill": "lsof -ti:3010 | xargs kill -9 2>/dev/null || echo 'No process running on port 3010'",
    "restart": "npm run kill && npm run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:setup": "playwright install"
  },
