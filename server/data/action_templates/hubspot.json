    {
      "id": "hubspot_create_deal",
      "name": "Create HubSpot Deal",
      "description": "Create a new deal in HubSpot CRM with amount, stage, and associated contact",
      "category": "crm",
      "status": "active",
      "integrations": [
        {
          "integration_type": "hubspot",
          "required": true,
          "features": [
            "deals.write"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "dealname",
            "type": "string",
            "description": "Name of the deal",
            "required": true
          },
          {
            "name": "amount",
            "type": "string",
            "description": "Deal amount (e.g., '10000.00')",
            "required": true
          },
          {
            "name": "dealstage",
            "type": "string",
            "description": "Deal stage (e.g., 'appointmentscheduled', 'qualifiedtobuy', 'presentationscheduled')",
            "required": true
          },
          {
            "name": "contact_id",
            "type": "string",
            "description": "Associated contact ID"
          },
          {
            "name": "company_id",
            "type": "string",
            "description": "Associated company ID"
          },
          {
            "name": "closedate",
            "type": "string",
            "description": "Expected close date (YYYY-MM-DD)"
          }
        ]
      },
      "default_config": {
        "url": "https://api.hubapi.com/crm/v3/objects/deals",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer ${secret:hubspot_oauth_token.access_token}",
          "Content-Type": "application/json"
        },
        "body": {
          "properties": {
            "dealname": "{{dealname}}",
            "amount": "{{amount}}",
            "dealstage": "{{dealstage}}",
            "closedate": "{{closedate}}"
          },
          "associations": [
            {
              "to": {
                "id": "{{contact_id}}"
              },
              "types": [
                {
                  "associationCategory": "HUBSPOT_DEFINED",
                  "associationTypeId": 1
                }
              ]
            }
          ]
        },
        "integration_metadata": {
          "type": "hubspot",
          "operation": "create_deal"
        }
      },
      "tags": [
        "crm",
        "deals",
        "hubspot",
        "sales"
      ],
      "examples": [
        {
          "name": "New Sales Deal",
          "config": {
            "dealname": "Enterprise Software License",
            "amount": "50000.00",
            "dealstage": "qualifiedtobuy",
            "closedate": "2024-06-30"
          }
        }
      ],
      "popularity_score": 92
    },
