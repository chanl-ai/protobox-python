    {
      "id": "hubspot_get_engagement_history",
      "name": "Get HubSpot Engagement History",
      "description": "Retrieve recent engagement history including emails, calls, tasks, meetings, and notes for a specific contact, company, or deal",
      "category": "crm",
      "status": "active",
      "integrations": [
        {
          "integration_type": "hubspot",
          "required": true,
          "features": [
            "crm.objects.contacts.read",
            "crm.objects.companies.read",
            "crm.objects.deals.read",
            "crm.objects.emails.read",
            "crm.objects.calls.read",
            "crm.objects.tasks.read",
            "crm.objects.meetings.read",
            "crm.objects.notes.read"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "object_type",
            "type": "string",
            "description": "Type of object to get engagement for (contacts, companies, deals)",
            "required": true,
            "enum": ["contacts", "companies", "deals"]
          },
          {
            "name": "object_id",
            "type": "string",
            "description": "ID of the object to get engagement for",
            "required": true
          },
          {
            "name": "limit",
            "type": "number",
            "description": "Maximum number of engagement records to return",
            "default": 20
          },
          {
            "name": "engagement_types",
            "type": "string",
            "description": "Comma-separated list of engagement types (emails, calls, tasks, meetings, notes)",
            "default": "emails,calls,tasks,meetings,notes"
          }
        ]
      },
      "default_config": {
        "url": "https://api.hubapi.com/crm/v3/objects/{{object_type}}/{{object_id}}/associations/{{engagement_types}}",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer ${secret:hubspot_oauth_token.access_token}"
        },
        "query_params": {
          "limit": "{{limit}}"
        },
        "integration_metadata": {
          "type": "hubspot",
          "operation": "get_engagement_history"
        }
      },
      "tags": [
        "crm",
        "engagement",
        "history",
        "hubspot"
      ],
      "examples": [
        {
          "name": "Get Contact Engagement",
          "config": {
            "object_type": "contacts",
            "object_id": "12345",
            "limit": 10,
            "engagement_types": "emails,calls,meetings"
          }
        }
      ],
      "popularity_score": 90
    },
