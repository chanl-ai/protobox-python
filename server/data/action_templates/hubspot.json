{
  "version": "1.0.0",
  "category": "hubspot",
  "templates": [
    {
      "id": "hubspot_create_contact",
      "name": "Create HubSpot Contact",
      "description": "Create a new contact in HubSpot CRM with basic information and custom properties",
      "category": "crm",
      "status": "active",
      "integrations": [
        {
          "integration_type": "hubspot",
          "required": true,
          "features": [
            "contacts.write"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "email",
            "type": "string",
            "description": "Contact email address",
            "required": true
          },
          {
            "name": "firstname",
            "type": "string",
            "description": "Contact first name"
          },
          {
            "name": "lastname",
            "type": "string",
            "description": "Contact last name"
          },
          {
            "name": "phone",
            "type": "string",
            "description": "Contact phone number"
          },
          {
            "name": "company",
            "type": "string",
            "description": "Company name"
          },
          {
            "name": "jobtitle",
            "type": "string",
            "description": "Job title"
          }
        ]
      },
      "default_config": {
        "url": "https://api.hubapi.com/crm/v3/objects/contacts",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer ${secret:hubspot_oauth_token.access_token}",
          "Content-Type": "application/json"
        },
        "body": {
          "properties": {
            "email": "{{email}}",
            "firstname": "{{firstname}}",
            "lastname": "{{lastname}}",
            "phone": "{{phone}}",
            "company": "{{company}}",
            "jobtitle": "{{jobtitle}}"
          }
        },
        "integration_metadata": {
          "type": "hubspot",
          "operation": "create_contact"
        }
      },
      "tags": [
        "crm",
        "contacts",
        "hubspot"
      ],
      "examples": [
        {
          "name": "New Lead Contact",
          "config": {
            "email": "john.doe@example.com",
            "firstname": "John",
            "lastname": "Doe",
            "company": "Acme Corp",
            "jobtitle": "Sales Manager"
          }
        }
      ],
      "popularity_score": 95
    },
