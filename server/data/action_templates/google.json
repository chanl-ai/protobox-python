    {
      "id": "gmail_search_emails",
      "name": "Search Gmail Messages",
      "description": "Search for emails in Gmail using advanced query syntax",
      "category": "communication",
      "status": "active",
      "integrations": [
        {
          "integration_type": "gmail",
          "required": true,
          "features": [
            "gmail.readonly"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "query",
            "type": "string",
            "description": "Gmail search query (e.g., 'from:user@example.com subject:invoice')",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "description": "Maximum number of results to return (1-500, default: 10)",
            "default": 10
          },
          {
            "name": "includeSpamTrash",
            "type": "boolean",
            "description": "Include spam and trash in search results (default: false)",
            "default": false
          }
        ]
      },
      "default_config": {
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages?q={{query}}&maxResults={{maxResults}}&includeSpamTrash={{includeSpamTrash}}",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer ${secret:gmail_oauth_token.access_token}"
        }
      },
      "tags": [
        "email",
        "gmail",
