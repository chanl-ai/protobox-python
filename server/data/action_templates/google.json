    {
      "id": "google_analytics_get_report",
      "name": "Get Google Analytics Report",
      "description": "Retrieve data from Google Analytics for a specific profile and date range",
      "category": "analytics",
      "status": "active",
      "integrations": [
        {
          "integration_type": "google_analytics",
          "required": true,
          "features": [
            "analytics.readonly"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "viewId",
            "type": "string",
            "description": "View ID for the Google Analytics profile",
            "required": true
          },
          {
            "name": "startDate",
            "type": "string",
            "description": "Start date for the report (YYYY-MM-DD)",
            "required": true
          },
          {
            "name": "endDate",
            "type": "string",
            "description": "End date for the report (YYYY-MM-DD)",
            "required": true
          },
          {
            "name": "metrics",
            "type": "string",
            "description": "Array of metrics to include in the report (comma-separated, e.g., 'ga:sessions,ga:pageviews')",
            "required": true
          },
          {
            "name": "dimensions",
            "type": "string",
            "description": "Array of dimensions to include in the report (comma-separated, e.g., 'ga:date,ga:source')",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "description": "Maximum number of results to return (1-1000, default: 10)",
            "default": 10
          }
        ]
      },
      "default_config": {
        "url": "https://analyticsreporting.googleapis.com/v4/reports:batchGet",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer ${secret:google_analytics_oauth_token.access_token}",
          "Content-Type": "application/json"
        },
        "body": {
          "reportRequests": [
            {
              "viewId": "{{viewId}}",
              "dateRanges": [
                {
                  "startDate": "{{startDate}}",
                  "endDate": "{{endDate}}"
                }
              ],
              "metrics": [
                {
                  "expression": "{{metrics}}"
                }
              ],
              "dimensions": [
                {
                  "name": "{{dimensions}}"
                }
              ],
              "maxResults": "{{maxResults}}"
            }
          ]
