{
  "version": "1.0.0",
  "category": "google",
  "templates": [
    {
      "id": "google_calendar_create_event",
      "name": "Create Calendar Event",
      "description": "Create a new event in Google Calendar with attendees, reminders, and recurring options",
      "category": "scheduling",
      "status": "active",
      "integrations": [
        {
          "integration_type": "google_calendar",
          "required": true,
          "features": [
            "calendar.events.create"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "summary",
            "type": "string",
            "description": "Event title",
            "required": true
          },
          {
            "name": "description",
            "type": "string",
            "description": "Event description"
          },
          {
            "name": "start",
            "type": "string",
            "description": "Start time (RFC3339 format without timezone offset, e.g. 2024-03-15T10:00:00Z)",
            "required": true
          },
          {
            "name": "end",
            "type": "string",
            "description": "End time (RFC3339 format without timezone offset, e.g. 2024-03-15T11:00:00Z)",
            "required": true
          },
          {
            "name": "location",
            "type": "string",
            "description": "Event location"
          },
          {
            "name": "calendar_id",
            "type": "string",
            "default": "primary",
            "description": "Calendar ID (default: primary)"
          }
        ]
      },
      "default_config": {
        "url": "https://www.googleapis.com/calendar/v3/calendars/{{calendar_id}}/events",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer ${secret:google_calendar_oauth_token.access_token}",
          "Content-Type": "application/json"
        },
        "integration_metadata": {
          "type": "google_calendar",
          "operation": "create_event"
        },
        "reminders": {
          "useDefault": true
        },
        "body": {
          "summary": "{{summary}}",
          "description": "{{description}}",
          "start": {
            "dateTime": "{{start}}",
            "timeZone": "America/New_York"
          },
          "end": {
            "dateTime": "{{end}}",
            "timeZone": "America/New_York"
          },
          "location": "{{location}}"
        }
      },
      "tags": [
        "calendar",
        "meeting",
        "schedule"
      ],
      "examples": [
        {
          "name": "Team Meeting",
          "config": {
            "summary": "Weekly Team Sync",
            "description": "Discuss project updates",
            "start": "2024-03-15T10:00:00Z",
            "end": "2024-03-15T11:00:00Z",
            "attendees": [
              "team@company.com"
            ]
          }
        }
      ],
      "popularity_score": 95
    },
    {
      "id": "google_calendar_check_availability",
      "name": "Check Calendar Availability",
      "description": "Check availability across one or more Google Calendars",
      "category": "scheduling",
      "status": "active",
      "integrations": [
        {
          "integration_type": "google_calendar",
          "required": true,
          "features": [
            "calendar.freebusy.query"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "time_min",
            "type": "string",
            "description": "Start of time range to check (RFC3339 format without timezone offset, e.g. 2024-03-18T00:00:00Z)",
            "required": true
          },
          {
            "name": "time_max",
            "type": "string",
            "description": "End of time range to check (RFC3339 format without timezone offset, e.g. 2024-03-22T23:59:59Z)",
            "required": true
          },
          {
            "name": "time_zone",
            "type": "string",
            "default": "UTC",
            "description": "Timezone for the query (default: UTC)"
          },
          {
            "name": "calendar_id",
            "type": "string",
            "default": "primary",
            "description": "Calendar ID (default: primary)"
          }
        ]
      },
      "default_config": {
        "url": "https://www.googleapis.com/calendar/v3/freeBusy",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer ${secret:google_calendar_oauth_token.access_token}",
          "Content-Type": "application/json"
        },
        "body": {
          "timeMin": "{{time_min}}",
          "timeMax": "{{time_max}}",
          "timeZone": "{{time_zone}}",
          "items": [
            {
              "id": "{{calendar_id}}"
            }
          ]
        },
        "integration_metadata": {
          "type": "google_calendar",
          "operation": "check_availability"
        }
      },
      "tags": [
        "calendar",
        "availability",
        "schedule",
        "freebusy"
      ],
      "examples": [
        {
          "name": "Check next week availability",
          "config": {
            "time_min": "2024-03-18T00:00:00Z",
            "time_max": "2024-03-22T23:59:59Z",
            "calendars": [
              "primary"
            ],
            "slot_duration_minutes": 60
          }
        }
      ],
      "popularity_score": 85
    },
    {
      "id": "gmail_send_email",
      "name": "Send Email via Gmail",
      "description": "Send an email using Gmail with support for HTML content and attachments",
      "category": "communication",
      "status": "active",
      "integrations": [
        {
          "integration_type": "gmail",
          "required": true,
          "features": [
            "gmail.send"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "to_name",
            "type": "string",
            "description": "Recipient name",
            "required": true
          },
          {
            "name": "to_email",
            "type": "string",
            "description": "Recipient email address",
            "required": true
          },
          {
            "name": "subject",
            "type": "string",
            "description": "Email subject",
            "required": true
          },
          {
            "name": "content",
            "type": "string",
            "description": "Email content",
            "required": true
          }
        ]
      },
      "default_config": {
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer ${secret:gmail_oauth_token.access_token}",
          "Content-Type": "application/json"
        },
        "body": {
          "raw": "To: {{to_name}} <{{to_email}}>\nSubject: {{subject}}\n\n{{content}}"
        },
        "body_preprocessors": [
          {
            "type": "base64",
            "fields": ["raw"]
          }
        ]
      },
      "tags": [
        "email",
        "gmail",
        "communication"
      ],
      "popularity_score": 95
    },
