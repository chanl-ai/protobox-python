{
  "version": "1.0.0",
  "category": "ai",
  "templates": [
    {
      "id": "openai_generate_text",
      "name": "Generate Text with AI",
      "description": "Generate text using OpenAI's GPT models",
      "category": "ai",
      "status": "active",
      "integrations": [
        {
          "integration_type": "openai",
          "required": true,
          "features": [
            "completions"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "prompt",
            "type": "string",
            "description": "Input prompt for text generation",
            "required": true
          },
          {
            "name": "model",
            "type": "string",
            "description": "OpenAI model to use for generation (default: gpt-4o-mini)",
            "default": "gpt-4o-mini",
            "required": true
          }
        ]
      },
      "default_config": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer ${secret:openai_api_key}",
          "Content-Type": "application/json"
        },
        "integration_metadata": {
          "type": "openai",
          "operation": "generate_text"
        },
        "body": {
          "model": "{{model}}",
          "messages": [
            {
              "role": "developer",
              "content": "{{prompt}}"
            }
          ],
          "temperature": 0.7,
          "max_tokens": 400
        }
      },
      "tags": [
        "ai",
        "text-generation",
        "nlp",
        "openai"
      ],
      "examples": [
        {
          "name": "Simple Text Generation",
          "config": {
            "prompt": "Write a short story about a robot learning to paint",
            "model": "gpt-4o-mini",
            "max_tokens": 200,
            "temperature": 0.8
          }
        },
        {
          "name": "Creative Writing",
          "config": {
            "prompt": "Create a poem about artificial intelligence",
            "model": "gpt-4o-mini",
            "max_tokens": 150,
            "temperature": 0.9
          }
        }
      ],
      "popularity_score": 88
    },
    {
      "id": "openai_analyze_sentiment",
      "name": "Analyze Text Sentiment",
      "description": "Analyze the sentiment and emotional tone of text using OpenAI's models",
      "category": "ai",
      "status": "active",
      "integrations": [
        {
          "integration_type": "openai",
          "required": true,
          "features": [
            "completions"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "text",
            "type": "string",
            "description": "Text to analyze for sentiment",
            "required": true
          },
          {
            "name": "model",
            "type": "string",
            "description": "OpenAI model to use for analysis (default: gpt-4o-mini)",
            "default": "gpt-4o-mini",
            "required": true
          },
          {
            "name": "analysis_type",
            "type": "string",
            "description": "Type of analysis to perform (default: sentiment)",
            "default": "sentiment",
            "required": true
          }
        ]
      },
      "default_config": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer ${secret:openai_api_key}",
          "Content-Type": "application/json"
        },
        "integration_metadata": {
          "type": "openai",
          "operation": "analyze_sentiment"
        },
        "body": {
          "model": "{{model}}",
          "messages": [
            {
              "role": "system",
              "content": "You are a sentiment analysis expert. Analyze the following text and provide a detailed sentiment analysis including emotional tone, confidence level, and key emotional indicators."
            },
            {
              "role": "developer",
              "content": "Please analyze the sentiment of this text: {{text}}"
            }
          ],
          "max_tokens": 300,
          "temperature": 0.3
        }
      },
      "tags": [
        "ai",
        "sentiment-analysis",
        "nlp",
        "openai"
      ],
      "examples": [
        {
          "name": "Customer Review Analysis",
          "config": {
            "text": "This product exceeded my expectations! The quality is amazing and customer service was outstanding.",
            "model": "gpt-4o-mini",
            "analysis_type": "sentiment"
          }
        }
      ],
      "popularity_score": 82
    },
    {
      "id": "openai_summarize_text",
      "name": "Summarize Text",
      "description": "Generate concise summaries of longer text using OpenAI's models",
      "category": "ai",
      "status": "active",
      "integrations": [
        {
          "integration_type": "openai",
          "required": true,
          "features": [
            "completions"
          ]
        }
      ],
      "action_type": "REST",
      "config_schema": {
        "inputVariables": [
          {
            "name": "text",
            "type": "string",
            "description": "Text to summarize",
            "required": true
          },
          {
            "name": "model",
            "type": "string",
            "description": "OpenAI model to use for summarization (default: gpt-4o-mini)",
            "default": "gpt-4o-mini",
            "required": true
          },
          {
            "name": "max_length",
            "type": "number",
            "description": "Maximum length of the summary in words",
            "default": 100,
            "required": true
          },
          {
            "name": "style",
            "type": "string",
            "description": "Style of the summary (bullet points, paragraph, etc.) (default: paragraph)",
            "default": "paragraph",
            "required": true
          }
        ]
      },
      "default_config": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer ${secret:openai_api_key}",
          "Content-Type": "application/json"
        },
        "integration_metadata": {
          "type": "openai",
          "operation": "summarize_text"
        },
        "body": {
          "model": "{{model}}",
          "messages": [
            {
              "role": "system",
              "content": "You are a professional summarizer. Create a concise summary of the following text in approximately {{max_length}} words. Use a {{style}} format."
            },
            {
              "role": "developer",
              "content": "Please summarize this text: {{text}}"
            }
          ],
          "max_tokens": 400,
          "temperature": 0.3
        }
      },
      "tags": [
        "ai",
        "summarization",
        "nlp",
        "openai"
      ],
      "examples": [
        {
          "name": "Article Summary",
          "config": {
            "text": "Long article content here...",
            "model": "gpt-4o-mini",
            "max_length": 150,
            "style": "bullet points"
          }
        }
      ],
      "popularity_score": 80
    }
  ]
}