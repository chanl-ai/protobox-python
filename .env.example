# Copy to .env. `make setup` does this and fills the three keys below with random values.

# Required. Each must be at least 32 characters; the server refuses to start otherwise.
JWT_SECRET=
MCP_SECRET_KEY=
DOCUMENT_PROCESSOR_API_KEY=

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3010
MCP_SERVER_URL=http://localhost:8090
MCP_BASE_URL=http://localhost:8090

# Firebase. The local stack uses the Auth emulator, so no real project is needed.
FIREBASE_PROJECT_ID=demo-protobox

# Knowledge base embeddings and LLM chunking. Without a key the knowledge base is unavailable
# (its routes return 503); everything else works.
OPENAI_API_KEY=

# Object storage for uploaded files (any S3-compatible service). Optional for text and URL sources.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_BUCKET_NAME=

# Egress workers (workers/). Needed only to run REST and code tools; see workers/README.md.
REST_EXECUTOR_WORKER_URL=
REST_EXECUTOR_WORKER_TOKEN=
CLOUDFLARE_DISPATCHER_URL=
CODE_EXECUTOR_WORKER_TOKEN=

# Optional third-party OAuth apps for integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
